# ============================================================
# microduck_manipulation — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example is tracked.
# ============================================================

# --- Hugging Face Hub ---
# Required for pushing/pulling datasets and model checkpoints.
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Dataset repo on HF Hub ---
# e.g., your-username/microduck-sock-pickplace-demos
HF_DATASET_REPO=

# --- Model repo on HF Hub ---
# e.g., your-username/microduck-sock-pickplace-policy
HF_MODEL_REPO=

# --- microduck_rl reference ---
# Local path to a clone of pollen-robotics/microduck_rl
# Used to resolve the robot MJCF and walking policy checkpoint.
# If unset, falls back to external/microduck_rl_pin.json for the
# commit hash and fetches from the remote repo.
MICRODUCK_RL_LOCAL_PATH=

# --- Cloud training (only needed in cloud env, not locally) ---
# CUDA_VISIBLE_DEVICES=0
